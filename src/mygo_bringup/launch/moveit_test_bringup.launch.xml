<launch>
    <let name="urdf_path"
         value="$(find-pkg-share mygo_robot_description)/urdf/main.urdf.xacro"/>
    <let name="robot_description_content"
         value="$(command 'xacro $(var urdf_path)')"/>
    <let name="rviz_config_path"
         value="$(find-pkg-share mygo_bringup)/config/moveit.rviz"/>

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description"
               value="$(var robot_description_content)" />
        <param name="use_sim_time" value="false"/>
    </node>

    <node pkg="controller_manager" exec="ros2_control_node">
        <param from="$(find-pkg-share mygo_bringup)/config/ros2_controllers.yaml"/>
        <param name="robot_description"
               value="$(var robot_description_content)" />
        <param name="use_sim_time" value="false"/>
        <remap from="~/robot_description" to="/robot_description"/>
    </node>

    <node pkg="controller_manager" exec="spawner" args="joint_state_broadcaster"/>
    <node pkg="controller_manager" exec="spawner" args="arm_controller"/>
    <node pkg="controller_manager" exec="spawner" args="gripper_controller"/>

    <include file="$(find-pkg-share mygo_moveit_config)/launch/move_group.launch.py" />

    <include file="$(find-pkg-share joystick_parser)/launch/joy_bringup.launch.xml" />
    <node pkg="state_machine" exec="state_machine" output="screen"/>

    <node pkg="robot_hardware_interfaces" exec="chassis_serial_node" output="screen"/>

    <node pkg="robot_hardware_interfaces" exec="arm_serial_node" output="screen"/>
    <node pkg="robot_hardware_interfaces" exec="pole_serial_node" output="screen"/>
    <node pkg="robot_hardware_interfaces" exec="collector_serial_node" output="screen"/>
    <node pkg="robot_hardware_interfaces" exec="camera_serial_node" output="screen"/>

    <node pkg="robot_hardware_interfaces" exec="commander" output="screen">
        <param name="robot_description"
               value="$(var robot_description_content)" />
    </node>

    <node pkg="rviz2" exec="rviz2" output="screen"
          args="-d $(var rviz_config_path)"/>
</launch>
